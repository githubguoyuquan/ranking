DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ranking?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3000

# Comma-separated brokers (Redpanda in docker-compose exposes 19092 on host)
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=ranking-platform
# KAFKA_TOPIC_RANKING_SNAPSHOT_COMPLETED=ranking.snapshot.completed

# CORS（管理前端默认 http://localhost:3001；多个 origin 用逗号分隔）
# CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001
