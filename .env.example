DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ranking?schema=public"
# 可选只读副本（rank-history / 热点聚合等读路径）
# DATABASE_READ_URL=postgresql://postgres:postgres@localhost:5432/ranking?schema=public
REDIS_URL="redis://localhost:6379"
# BullMQ 与「排行实时」共用；Dev 可省略覆盖（默认 ranking:realtime:v1）
# REALTIME_REDIS_CHANNEL=ranking:realtime:v1
# REALTIME_SSE_HEARTBEAT_MS=25000
# REALTIME_SSE_DISABLED=false
# REALTIME_PUBLISH_DISABLED=false

# 快照 GET 缓存（默认开启；无 Redis 时命令失败会降级查库，但异步排行仍需 Redis）
# RANKING_CACHE_ENABLED=false
# RANKING_CACHE_TTL_SECONDS=604800
# LEADERBOARD_CACHE_TTL_SECONDS=120
# RANKING_CACHE_REDIS_DB=0

# 物化成功后 BullMQ 编排队列（默认入队；设为 true 则不调 add）
# RANKING_FOLLOWUP_DISABLED=false
# follow-up Worker 内额外写 Outbox（类型 ranking.followup.requested；无 Kafka 投递）
# RANKING_FOLLOWUP_OUTBOX=false
# 若设置非空，则**仅**按此逗号分隔顺序跑流水线（不再读取下方三个独立开关）；链式下一步可读到前序摘要（OPENAI 时写入 user 前缀）
# RANKING_FOLLOWUP_ANALYZE_PIPELINE=post-snapshot-summary-v1,trend-v1,credibility-v1
# follow-up 内自动写 AiAnalysis（agent=post-snapshot-summary-v1；失败仅打日志）
# RANKING_FOLLOWUP_ANALYZE=false
# 物化跟进链可选：趋势解读 / 可信度短评（共用 RANKING_FOLLOWUP_ANALYZE_TOPN；各占一条 AiAnalysis 配额）
# RANKING_FOLLOWUP_ANALYZE_TREND=false
# RANKING_FOLLOWUP_ANALYZE_CREDIBILITY=false
# RANKING_FOLLOWUP_ANALYZE_TOPN=8
# 全局 AiAnalysis 条数上限占位（UTC 自然日；不设置则不限制）
# AI_ANALYSIS_DAILY_CAP=
# 全局 OpenAI embedding **批量成功**次数上限（UTC 自然日；一次 embedMany 计 1；不设置则不限制）
# AI_EMBEDDING_DAILY_CAP=
# 是否将 embedding 调用写入 AiAuditEvent（默认开启；设为 false 关闭）
# AI_EMBEDDING_AUDIT=true

# 多 Agent 编排（BullMQ 队列 `ai-agent`：Topic Discovery / Merge / FactCheck / Duplicate Detection）
# AI_AGENT_DISABLED=false
# 爬取任务完成后自动入队 topic-discovery-v1（需 Redis + API/Worker 消费 ai-agent 队列）
# AI_AGENT_CRAWL_DISCOVERY=false
# 管理台「入队 pipeline」默认 agents（逗号分隔，可被 POST body 覆盖）
# AI_AGENT_DEFAULT_PIPELINE=topic-discovery-v1,duplicate-detection-v1

# 进程角色：all（默认单进程）| api | worker | platform-worker 入口固定 worker | crawl
# PROCESS_ROLE=all

# 留空则**不连 Kafka**，Outbox 只落库不发布（本地可不用 Redpanda）
# KAFKA_BROKERS=localhost:19092
# Redpanda Schema Registry（compose 映射 18081）
# KAFKA_SCHEMA_REGISTRY_URL=http://localhost:18081
# KAFKA_TOPIC_RANKING_SNAPSHOT_COMPLETED=ranking.snapshot.completed
# KAFKA_TOPIC_CRAWL_URL_FETCHED=crawl.url.fetched
# KAFKA_MESH_CRAWL_EVENTS=false
# KAFKA_MESH_AI_AGENT_EVENTS=false
# kafkajs 日志级别 NOTHING|ERROR|WARN|INFO|DEBUG（默认 NOTHING，避免刷屏）
# KAFKAJS_LOG_LEVEL=NOTHING

# Outbox 发布轮询（ms）与抢到行后的租约（秒，默认 120）
# OUTBOX_FLUSH_MS=2000
# OUTBOX_LEASE_SECONDS=120

# KAFKA_TOPIC_RANKING_SNAPSHOT_COMPLETED=ranking.snapshot.completed
# Kafka 发布前 JSON Schema 校验（救急可 true 关闭，勿长期用于生产）
# KAFKA_SKIP_SCHEMA_VALIDATION=false

# CORS（管理前端默认 http://localhost:3001；多个 origin 用逗号分隔）
# CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

# ClickHouse（`docker compose up -d clickhouse` 后可用 http://localhost:8123）
# CLICKHOUSE_URL=http://localhost:8123
# CLICKHOUSE_DATABASE=ranking
# 仅在设为 true 时，榜单快照落库后同步写入 metric_timeseries
# SYNC_RANKING_TO_CLICKHOUSE=true
# direct：API 事务后立即写 CH；outbox：同事务插入 Outbox，由进程内 Flusher 异步写 CH（与 Kafka 行分流）
# CLICKHOUSE_WRITE_MODE=direct

# 主检索引擎：`auto`（默认 Qdrant → ES → PG）| `qdrant` | `es` | `pg`
# SEARCH_PRIMARY=auto

# Qdrant（`docker compose up -d qdrant` → http://localhost:6333；配置后默认优先于 ES）
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION_ENTITIES=ranking_entities
# QDRANT_COLLECTION_CRAWLED_URLS=ranking_crawled_urls

# Elasticsearch（`docker compose up -d elasticsearch` → http://localhost:9200；可选降级/并行索引）
# ELASTICSEARCH_NODE=http://localhost:9200
# ELASTICSEARCH_INDEX_ENTITIES=ranking_entities
# 爬取摘要全文索引（与实体索引分立）
# ELASTICSEARCH_INDEX_CRAWLED_URLS=ranking_crawled_urls
# 索引滚动：先 bootstrap 写别名，再 rollover（见 POST /admin/scale/elasticsearch/*）
# ELASTICSEARCH_USE_WRITE_ALIAS=false
# 亿级写入：默认 bulk 不 refresh；仅调试时 true
# ELASTICSEARCH_REFRESH_ON_WRITE=false
# ELASTICSEARCH_BULK_BATCH_SIZE=500
# ELASTICSEARCH_INDEX_SHARDS=3
# ELASTICSEARCH_INDEX_REPLICAS=1
# ELASTICSEARCH_ROLLOVER_MAX_DOCS=50000000
# ELASTICSEARCH_ROLLOVER_MAX_AGE=30d

# 全球爬虫调度（API/platform-worker；`CRAWL_SCHEDULER_DISABLED=true` 关闭）
# CRAWL_SCHEDULER_REGION=eu-west
# CRAWL_SCHEDULER_DEDUPE_MINUTES=30
# CRAWL_QUEUE_SHARD=eu-west

# 抓取：默认桩；设为 true 或 Source.kind=http-fetch 时对 seedUrls 做真 HTTP GET + body SHA256
# CRAWL_HTTP_FETCH=true
# CRAWL_FETCH_TIMEOUT_MS=15000
# CRAWL_MAX_RESPONSE_BYTES=2000000
# CRAWL_USER_AGENT=RankingPlatformCrawler/0.1
# 文本 preview 最大字符（默认 8000；范围 500–500000）
# CRAWL_TEXT_PREVIEW_CHARS=8000
# 出站 HTTP(S) 代理（`fetch` 经 undici ProxyAgent；Playwright `proxy.server`）；可被 Source.httpProxyUrl 覆盖
# CRAWL_HTTP_PROXY=http://127.0.0.1:8888
# 水平扩展：多进程共用 REDIS_URL 消费 BullMQ `crawl` 队列（API 进程外可 `npm run start:crawl-worker` 仅起 Worker）
# CRAWL_WORKER_CONCURRENCY=6
# BullMQ job 锁（毫秒，默认 ≈ 抓取超时 + 120s，避免 Playwright 长任务被判 stalled）
# CRAWL_JOB_LOCK_MS=
# 跨实例同 host 礼貌间隔（毫秒，依赖 Redis SET NX；0 关闭）
# CRAWL_PER_HOST_MIN_INTERVAL_MS=0
# 语义去重：成功抓取后与同信源近期 canonical 行 embedding 比余弦（需 OPENAI_API_KEY）
# CRAWL_SEMANTIC_DEDUP=false
# CRAWL_SEMANTIC_DEDUP_THRESHOLD=0.92
# CRAWL_SEMANTIC_DEDUP_MIN_CHARS=80
# CRAWL_SEMANTIC_DEDUP_CANDIDATES=300
# 跨信源语义去重（PG 全库近期 embedding 比对；大规模应迁 ES ANN）
# CRAWL_SEMANTIC_DEDUP_CROSS_SOURCE=false
# CRAWL_SEMANTIC_DEDUP_CROSS_SOURCE_CANDIDATES=500
# 代理池（逗号/换行分隔；轮询覆盖 CRAWL_HTTP_PROXY，Source.httpProxyUrl 仍优先）
# CRAWL_PROXY_POOL=http://127.0.0.1:8888,http://127.0.0.1:8889
# BullMQ 队列分片名（多区域 Worker：`crawl:eu-west`）
# CRAWL_QUEUE_SHARD=
# 使用 Playwright Chromium 渲染后再抓取（需 `npm install` 后 `npx playwright install chromium`）
# CRAWL_USE_PLAYWRIGHT=true

# 快照 AI 简报（POST /admin/snapshots/:id/analyze）：可选 OpenAI 润色规则摘要
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# 实体语义检索 / 向量 kNN / 话题相似推荐（embeddings；默认 text-embedding-3-small，1536 维）
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Phase D — 鉴权 / 多租户 / 合规（开发默认开放 admin；生产请设 API_AUTH_REQUIRED=true）
# API_AUTH_REQUIRED=false
# API_ADMIN_OPEN=true
# 请求头：X-API-Key 或 Authorization: Bearer <rk_…>
# 管理：POST /admin/compliance/bootstrap-default-tenant → POST /admin/compliance/api-keys
# 法务导出：GET /admin/compliance/snapshots/:id/export?format=json|csv
# 租户 settingsJson 示例：{"aiAnalysisDailyCap":500,"aiEmbeddingDailyCap":200}

# 路线图 — 周期趋势 / CH 报表 / 可选向量与对象存储
# TREND_ANALYSIS_CRON_DISABLED=false
# QDRANT_URL=http://localhost:6333
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_BUCKET=ranking-artifacts
