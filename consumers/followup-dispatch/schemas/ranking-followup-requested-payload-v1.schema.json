{
  "$id": "https://ranking.platform/schemas/kafka/ranking-followup-requested-payload-v1.json",
  "title": "RankingFollowupRequestedPayloadV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "topicRankingId",
    "topicVersionId",
    "topicId",
    "timeWindow",
    "snapshotTime"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "snapshotId": { "type": "string", "pattern": "^[0-9]+$" },
    "topicRankingId": { "type": "string", "pattern": "^[0-9]+$" },
    "topicVersionId": { "type": "string", "pattern": "^[0-9]+$" },
    "topicId": { "type": "string", "pattern": "^[0-9]+$" },
    "timeWindow": {
      "type": "string",
      "enum": ["REALTIME", "DAY", "WEEK", "MONTH", "YEAR", "CUSTOM"]
    },
    "snapshotTime": { "type": "string", "format": "date-time" }
  }
}
