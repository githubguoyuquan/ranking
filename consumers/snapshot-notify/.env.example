# Snapshot notify consumer — `ranking.snapshot.completed`
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC_RANKING_SNAPSHOT_COMPLETED=ranking.snapshot.completed
KAFKA_CONSUMER_GROUP=ranking-snapshot-notify
KAFKA_CLIENT_ID=ranking-snapshot-notify

# 可选：物化后 POST 通知（Slack/Teams 兼容 JSON）
# SNAPSHOT_NOTIFY_WEBHOOK_URL=https://hooks.example.com/snapshot-ready

# 已处理 outboxId 账本（重启后仍幂等）
SNAPSHOT_NOTIFY_LEDGER_PATH=./data/processed-outbox-ids.jsonl

# 运维 HTTP（K8s 探针）
SNAPSHOT_NOTIFY_HTTP_PORT=3010
