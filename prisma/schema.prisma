generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TopicKind {
  OBJECTIVE
  SEMI_OBJECTIVE
  SUBJECTIVE_TREND
}

enum AiAuditCategory {
  CHAT_COMPLETION
  EMBEDDING
}

enum AiQuotaDecision {
  ALLOWED
  DENIED_DAILY_CAP
  SKIPPED_NO_API_KEY
}

enum TimeWindow {
  REALTIME
  DAY
  WEEK
  MONTH
  YEAR
  CUSTOM
}

enum TrendType {
  SURGE
  STEADY_UP
  FLAT
  VOLATILE
  STEADY_DOWN
  DECLINE
}

/// 实体 PII 分级（合规导出 / 检索脱敏）
enum PiiLevel {
  NONE
  LOW
  HIGH
}

enum ComplianceAuditAction {
  API_KEY_AUTH
  SNAPSHOT_COMPLIANCE_EXPORT
  SCORE_BREAKDOWN_EXPORT
  ENTITY_PII_ACCESS
}

/// 与下游消费者约定的事件类型（字符串，便于跨语言）
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  /// Kafka 外发完成时间（与 `publishedAt` 分流：ES/CH Flusher 仍写 `publishedAt`）
  kafkaPublishedAt DateTime?
  /// 多实例发布时租约；到期或未设置才可被 SKIP LOCKED 抢到
  leasedUntil DateTime?
  attempts    Int       @default(0)
  lastError   String?   @db.Text

  @@index([publishedAt, id])
  @@index([publishedAt, leasedUntil, id])
  @@index([type])
}

model Tenant {
  id           BigInt   @id @default(autoincrement())
  slug         String   @unique
  name         String
  /// 租户级配额等（如 `aiAnalysisDailyCap`）；未设则回落全局 env
  settingsJson Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  apiKeys   ApiKey[]
  topics    Topic[]
  entities  Entity[]
  sources   Source[]
  audits    ComplianceAuditEvent[]
}

/// API 密钥（仅存 SHA-256 摘要；请求头 `X-API-Key` 或 `Authorization: Bearer`）
model ApiKey {
  id         BigInt    @id @default(autoincrement())
  tenantId   BigInt
  label      String    @default("")
  keyPrefix  String    @db.VarChar(16)
  keyHash    String    @unique @db.VarChar(64)
  scopes     Json      @default("[\"read\",\"write\",\"admin\"]")
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([keyPrefix])
}

model ComplianceAuditEvent {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt?
  action    ComplianceAuditAction
  actor     String   @db.VarChar(128)
  resource  String?  @db.VarChar(256)
  metadata  Json?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
}

model Topic {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt?
  slug      String   @unique
  title     String
  kind      TopicKind
  locale    String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  versions    TopicVersion[]
  sources     Source[]
  embedding   TopicEmbedding?
  fingerprint TopicFingerprint?
  entityStats EntityTopicStats[]
  agentRuns   AgentRun[]
  approvedProposals TopicProposal[] @relation("TopicProposalApproved")
  mergesAsSource    TopicMergeAudit[] @relation("TopicMergeSource")
  mergesAsTarget    TopicMergeAudit[] @relation("TopicMergeTarget")

  @@index([tenantId])
}

/// 话题语义向量（OpenAI embedding；用于相似话题推荐）
model TopicEmbedding {
  topicId   BigInt   @id
  model     String   @default("text-embedding-3-small")
  dims      Int
  vector    Json
  updatedAt DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model TopicVersion {
  id            BigInt    @id @default(autoincrement())
  topicId       BigInt
  version       String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  frozen        Boolean   @default(false)
  policyJson    Json

  topic    Topic           @relation(fields: [topicId], references: [id])
  rankings TopicRanking[]

  @@unique([topicId, version])
  @@index([topicId, frozen])
}

model TopicRanking {
  id             BigInt     @id @default(autoincrement())
  topicVersionId BigInt
  timeWindow     TimeWindow
  windowStart    DateTime
  windowEnd      DateTime
  /// queued | running | completed | failed
  status         String     @default("queued")
  queuedAt       DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  lastError      String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt

  topicVersion TopicVersion       @relation(fields: [topicVersionId], references: [id])
  snapshots    TopicRankSnapshot[]

  @@unique([topicVersionId, timeWindow, windowStart])
  @@index([topicVersionId, timeWindow, windowEnd])
  @@index([status])
}

model TopicRankSnapshot {
  id              BigInt   @id @default(autoincrement())
  topicRankingId  BigInt
  snapshotTime    DateTime
  snapshotVersion String
  rankingJson     Json
  trendSummary    String?
  generatedByAi   Boolean  @default(false)
  confidenceScore Float
  scoreModelId    BigInt?

  topicRanking TopicRanking @relation(fields: [topicRankingId], references: [id])
  scoreModel   ScoreModel?  @relation(fields: [scoreModelId], references: [id])
  items        RankingItem[]
  analyses     AiAnalysis[]
  aiAudits     AiAuditEvent[]
  agentRuns    AgentRun[]

  @@unique([topicRankingId, snapshotVersion])
  @@unique([topicRankingId, snapshotTime])
  @@index([snapshotTime])
}

model RankingItem {
  id               BigInt    @id @default(autoincrement())
  snapshotId       BigInt
  entityId         BigInt
  rank             Int
  previousRank     Int?
  /// Positive = moved up in rank (better position). previousRank - rank
  rankChange       Int?
  trendType        TrendType
  trendScore       Float
  popularityScore  Float
  authorityScore   Float
  controversyScore Float
  confidenceScore  Float
  scoreBreakdown   Json
  timeWindow       TimeWindow
  snapshotVersion  String
  generatedAt      DateTime

  snapshot TopicRankSnapshot @relation(fields: [snapshotId], references: [id])
  entity   Entity            @relation(fields: [entityId], references: [id])

  breakdowns ScoreBreakdown[]

  @@unique([snapshotId, entityId])
  @@index([entityId, generatedAt])
  @@index([snapshotId, rank])
}

model RankingItemHistory {
  id         BigInt     @id @default(autoincrement())
  entityId   BigInt
  topicId    BigInt
  timeWindow TimeWindow
  asOf       DateTime
  rank       Int
  score      Float
  snapshotId BigInt

  entity Entity @relation(fields: [entityId], references: [id])

  @@index([topicId, entityId, timeWindow, asOf])
}

model Entity {
  id            BigInt   @id @default(autoincrement())
  tenantId      BigInt?
  type          String
  canonicalName String
  aliases       Json?
  piiLevel      PiiLevel @default(NONE)
  createdAt     DateTime @default(now())

  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  metrics       EntityMetric[]
  relationsFrom EntityRelation[] @relation("EntityFrom")
  relationsTo   EntityRelation[] @relation("EntityTo")
  rankingItems  RankingItem[]
  histories     RankingItemHistory[]
  topicStats    EntityTopicStats[]

  @@index([tenantId])
  @@index([piiLevel])
}

/// 实体在话题下的名次极值与末端连续升降（每次快照后增量更新）
model EntityTopicStats {
  entityId            BigInt
  topicId             BigInt
  timeWindow          TimeWindow
  bestRank            Int
  worstRank           Int
  currentStreakUp     Int      @default(0)
  currentStreakDown   Int      @default(0)
  lastRank            Int?
  lastAsOf            DateTime?
  updatedAt           DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([entityId, topicId, timeWindow])
  @@index([topicId, timeWindow])
}

/// 话题语义指纹（SimHash / 向量元数据），支撑去重与合并
model TopicFingerprint {
  topicId        BigInt   @id
  simhash        String   @db.VarChar(64)
  embeddingModel String?  @db.VarChar(128)
  updatedAt      DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model EntityMetric {
  id         BigInt   @id @default(autoincrement())
  entityId   BigInt
  metricKey  String
  value      Float
  unit       String?
  sourceTier Int      @default(3)
  observedAt DateTime

  entity Entity @relation(fields: [entityId], references: [id])

  @@index([entityId, metricKey, observedAt])
}

model MetricTimeSeriesRef {
  id        BigInt @id @default(autoincrement())
  entityId  BigInt
  metricKey String
  chTable   String
  partition String?

  @@unique([entityId, metricKey])
}

model TrendAnalysis {
  id        BigInt   @id @default(autoincrement())
  topicId   BigInt
  entityId  BigInt?
  window    TimeWindow
  payload   Json
  createdAt DateTime @default(now())

  @@index([topicId, entityId, createdAt])
}

model ScoreModel {
  id        BigInt   @id @default(autoincrement())
  name      String
  version   String
  weights   Json
  createdAt DateTime @default(now())

  snapshots  TopicRankSnapshot[]
  breakdowns ScoreBreakdown[]
}

model ScoreBreakdown {
  id            BigInt @id @default(autoincrement())
  modelId       BigInt
  rankingItemId BigInt
  component     String
  value         Float
  weight        Float
  note          String?

  model ScoreModel  @relation(fields: [modelId], references: [id])
  item  RankingItem @relation(fields: [rankingItemId], references: [id])

  @@index([rankingItemId])
}

model Source {
  id        BigInt  @id @default(autoincrement())
  tenantId  BigInt?
  topicId   BigInt?
  name      String
  baseUrl   String
  /// demo | http-fetch | http-playwright：后两者在开启真抓取时分别用 fetch 或 Playwright
  kind      String
  trustTier Int     @default(3)
  /// 可选 HTTP(S) 代理（覆盖全局 CRAWL_HTTP_PROXY）；如 http://host:3128
  httpProxyUrl String? @db.VarChar(2048)
  /// 全球调度：启用后由 `CrawlSchedulerService` 按间隔/区域入队
  scheduleEnabled          Boolean   @default(false)
  /// 轮询间隔（分钟）；与 `scheduleCron` 二选一，优先 interval
  scheduleIntervalMinutes  Int?
  /// 标准 5 段 cron（UTC 或 scheduleTimezone）；如 0 star/6 star star star
  scheduleCron             String?   @db.VarChar(64)
  scheduleTimezone         String    @default("UTC") @db.VarChar(64)
  /// 区域标签 → BullMQ crawl:region；空则默认 crawl 或 CRAWL_QUEUE_SHARD
  region                   String?   @db.VarChar(64)
  schedulePriority         Int       @default(0)
  lastScheduledAt          DateTime?

  tenant     Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  topic      Topic?       @relation(fields: [topicId], references: [id])
  urls       CrawledUrl[]
  crawlTasks CrawlTask[]
  topicProposals TopicProposal[]
  scheduleRuns CrawlScheduleRun[]

  @@index([tenantId])
  @@index([scheduleEnabled, region])
}

/// 全球调度审计（计划入队 / 跳过 / 失败）
model CrawlScheduleRun {
  id           BigInt   @id @default(autoincrement())
  sourceId     BigInt
  crawlTaskId  BigInt?
  region       String?  @db.VarChar(64)
  status       String   @db.VarChar(32)
  detail       String?  @db.Text
  scheduledAt  DateTime @default(now())

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, scheduledAt])
  @@index([scheduledAt])
}

model CrawlTask {
  id        BigInt   @id @default(autoincrement())
  sourceId  BigInt
  status    String
  cursor    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source Source @relation(fields: [sourceId], references: [id])
}

model CrawlCheckpoint {
  id            BigInt    @id @default(autoincrement())
  crawlerName   String    @unique
  lastCursor    String?
  lastUrl       String?
  lastTopic     String?
  lastProcessed DateTime?
  meta          Json?
}

model CrawledUrl {
  id             BigInt   @id @default(autoincrement())
  sourceId       BigInt
  url            String
  urlFingerprint String   @unique
  contentHash    String?
  /// Response Content-Type 主类型（不含 charset）
  mimeType       String?  @db.VarChar(255)
  /// 文本类响应的规范化摘录（供检索/摘要；非文本则为 null）
  textPreview    String?  @db.Text
  /// HTML `<title>` 或无头浏览器 `document.title`（≤512；供列表与检索）
  pageTitle      String?  @db.VarChar(512)
  status         String
  fetchedAt      DateTime?
  /// 语义去重：指向同信源下已索引的正文代表行（本行不写 ES 正文索引）
  duplicateOfId BigInt?
  /// 供同信源语义去重比对用的 embedding（仅 canonical `fetched` 行可能非空）
  previewEmbedding       Json?
  previewEmbeddingModel  String? @db.VarChar(128)
  /// meta/og/h1/canonical 等结构化特征
  domFeaturesJson        Json?

  source      Source       @relation(fields: [sourceId], references: [id])
  duplicateOf CrawledUrl?  @relation("CrawledUrlSemanticDup", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  CrawledUrl[] @relation("CrawledUrlSemanticDup")

  @@index([sourceId, status])
}

model AiAnalysis {
  id         BigInt   @id @default(autoincrement())
  snapshotId BigInt
  agent      String
  summary    String
  detailJson Json
  confidence Float
  createdAt  DateTime @default(now())

  snapshot TopicRankSnapshot @relation(fields: [snapshotId], references: [id])
  audits   AiAuditEvent[]

  @@index([snapshotId, agent])
}

model AiAuditEvent {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now())

  category  AiAuditCategory
  operation String          @db.VarChar(160)
  model     String?         @db.VarChar(128)
  snapshotId BigInt?
  aiAnalysisId BigInt?

  success       Boolean
  quotaDecision AiQuotaDecision?
  errorMessage  String?          @db.VarChar(2000)

  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?

  requestId String? @db.VarChar(128)
  source    String  @default("api") @db.VarChar(32)
  metadata  Json?

  snapshot TopicRankSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  analysis AiAnalysis?        @relation(fields: [aiAnalysisId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([snapshotId, createdAt])
  @@index([source, createdAt])
}

model EntityRelation {
  id       BigInt @id @default(autoincrement())
  fromId   BigInt
  toId     BigInt
  relation String
  weight   Float?
  evidence Json?

  from Entity @relation("EntityFrom", fields: [fromId], references: [id])
  to   Entity @relation("EntityTo", fields: [toId], references: [id])

  @@index([fromId, relation])
}

/// 多 Agent 编排单次执行记录（BullMQ `ai-agent` 队列）
model AgentRun {
  id            BigInt    @id @default(autoincrement())
  correlationId String    @db.VarChar(64)
  agent         String    @db.VarChar(120)
  /// queued | running | completed | failed
  status        String    @default("queued")
  inputJson     Json?
  outputJson    Json?
  snapshotId    BigInt?
  topicId       BigInt?
  proposalId    BigInt?
  parentRunId   BigInt?
  error         String?   @db.Text
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())

  snapshot TopicRankSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  topic    Topic?               @relation(fields: [topicId], references: [id], onDelete: SetNull)
  proposal TopicProposal?       @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  parent   AgentRun?            @relation("AgentRunChain", fields: [parentRunId], references: [id], onDelete: SetNull)
  children AgentRun[]           @relation("AgentRunChain")

  @@index([correlationId])
  @@index([agent, status, createdAt])
  @@index([snapshotId])
  @@index([topicId])
  @@index([proposalId])
}

/// Topic Discovery Agent 产出：待审核话题候选
model TopicProposal {
  id              BigInt    @id @default(autoincrement())
  /// pending | approved | rejected | merged
  status          String    @default("pending")
  suggestedSlug   String    @db.VarChar(128)
  suggestedTitle  String
  kind            TopicKind @default(SEMI_OBJECTIVE)
  confidence      Float     @default(0.5)
  evidenceJson    Json
  sourceId        BigInt?
  clusterKey      String?   @unique @db.VarChar(128)
  approvedTopicId BigInt?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  source        Source?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  approvedTopic Topic?     @relation("TopicProposalApproved", fields: [approvedTopicId], references: [id], onDelete: SetNull)
  agentRuns     AgentRun[]

  @@index([status, createdAt])
  @@index([sourceId])
}

/// Topic Merge Agent 审计
model TopicMergeAudit {
  id            BigInt   @id @default(autoincrement())
  sourceTopicId BigInt
  targetTopicId BigInt
  mergedBy      String   @default("system") @db.VarChar(128)
  detailJson    Json
  createdAt     DateTime @default(now())

  sourceTopic Topic @relation("TopicMergeSource", fields: [sourceTopicId], references: [id])
  targetTopic Topic @relation("TopicMergeTarget", fields: [targetTopicId], references: [id])

  @@index([targetTopicId, createdAt])
  @@index([sourceTopicId])
}

/// C 端匿名设备偏好（无登录；X-Device-Id 识别）
model SiteDeviceProfile {
  id           String   @id @default(cuid())
  deviceId     String   @unique @db.VarChar(64)
  tier         String   @default("free") @db.VarChar(32)
  recentTopics Json     @default("[]")
  watchlist    Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedAt])
  @@map("site_device_profiles")
}
